{
  "name": "sidebar-git-diff",
  "version": "1.0.0",
  "description": "Show uncommitted Git changes by session in the OpenCode terminal sidebar.",
  "type": "module",
  "license": "MIT",
  "keywords": ["opencode", "opencode-plugin", "git", "tui", "diff"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timrichardson/sidebar-git-diff.git"
  },
  "exports": {
    "./tui": "./src/tui.tsx"
  },
  "files": ["src/tui.tsx", "PROMPT.md"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm pack --dry-run",
    "release:next": "node scripts/next-release.mjs"
  },
  "dependencies": {
    "@opencode/plugin": "2.3.2"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.8.4 <1",
    "@opentui/solid": ">=0.8.4 <1",
    "solid-js": "^1.9.12"
  },
  "devDependencies": {
    "@opencode/client": "2.3.2",
    "@opentui/core": "0.8.4",
    "@opentui/solid": "0.8.4",
    "@types/node": "26.6.6",
    "solid-js": "1.9.17",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "tag": "latest"
  }
}
